# قاعدة البيانات (PostgreSQL - Neon أو غيره)
DATABASE_URL="postgresql://user:password@host:5432/selim_erp?sslmode=require"

# مفتاح سري للجلسات - يجب أن يكون 32 حرفاً عشوائياً على الأقل
# يمكن توليده بـ: openssl rand -base64 32
TOKEN_SECRET="change-this-to-a-random-secret-key-min-32-chars"

# بيئة التشغيل
NODE_ENV="production"
