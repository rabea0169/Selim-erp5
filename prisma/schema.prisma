// Prisma schema for Clothing Factory Management System
// نظام إدارة مصنع ملابس جاهزة - شامل

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// المستخدمون (تسجيل الدخول)
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  role         String   @default("admin") // admin / user
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// العمال
model Worker {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  job       String?  // الوظيفة: خياط، تفصيل، تشطيب...إلخ
  type      String   @default("monthly") // monthly = مرتب شهري / production = إنتاج بالقطعة
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  advances     WorkerAdvance[]
  receipts     WorkerReceipt[]
  attendance   WorkerAttendance[]
  productions  Production[]
}

// سلف العمال
model WorkerAdvance {
  id        String   @id @default(cuid())
  workerId  String
  amount    Float
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())

  worker    Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@index([date])
}

// قبض العمال
model WorkerReceipt {
  id        String   @id @default(cuid())
  workerId  String
  amount    Float
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())

  worker    Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@index([date])
}

// حضور وانصراف العمال
model WorkerAttendance {
  id        String   @id @default(cuid())
  workerId  String
  date      DateTime // يوم العمل
  checkIn   DateTime?
  checkOut  DateTime?
  status    String   @default("present") // present / absent / leave
  notes     String?
  createdAt DateTime @default(now())

  worker    Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@index([date])
}

// إنتاج العمال بالقطعة
model Production {
  id         String   @id @default(cuid())
  workerId   String
  date       DateTime
  modelName  String   // اسم الموديل / الصنف
  quantity   Float    // عدد القطع
  unitPrice  Float    // سعر القطعة
  total      Float    // الإجمالي
  notes      String?
  createdAt  DateTime @default(now())

  worker     Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@index([date])
}

// العملاء
model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())

  sales     Sale[]

  @@index([name])
}

// الموردين
model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())

  purchases Purchase[]

  @@index([name])
}

// المبيعات
model Sale {
  id         String   @id @default(cuid())
  invoiceNo  String?
  customerName String
  customerId_ref String?
  customer       Customer? @relation(fields: [customerId_ref], references: [id], onDelete: SetNull)
  date       DateTime
  total      Float
  paid       Float
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items SaleItem[]

  @@index([date])
  @@index([customerId_ref])
}

// أصناف البيع
model SaleItem {
  id        String @id @default(cuid())
  saleId    String
  itemName  String
  quantity  Float
  unitPrice Float
  total     Float

  sale      Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

// المشتريات
model Purchase {
  id           String   @id @default(cuid())
  invoiceNo    String?
  supplierName String
  supplierId_ref String?
  supplier     Supplier? @relation(fields: [supplierId_ref], references: [id], onDelete: SetNull)
  date         DateTime
  total        Float
  paid         Float
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items PurchaseItem[]

  @@index([date])
  @@index([supplierId_ref])
}

// أصناف المشتريات
model PurchaseItem {
  id        String @id @default(cuid())
  purchaseId String
  itemName  String
  quantity  Float
  unitPrice Float
  total     Float

  purchase  Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
}

// بنود المصاريف (فئات)
model ExpenseCategory {
  id      String @id @default(cuid())
  name    String
  notes   String?

  expenses Expense[]

  createdAt DateTime @default(now())
}

// المصاريف
model Expense {
  id         String   @id @default(cuid())
  categoryId String
  categoryName String
  amount     Float
  date       DateTime
  notes      String?
  createdAt  DateTime @default(now())

  category   ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([categoryId])
}
