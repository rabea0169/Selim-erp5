// Prisma schema for Selim ERP - Neon PostgreSQL
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ====== المستخدمون ======
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs AuditLog[]
}

// ====== سجل العمليات ======
model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  userName    String
  action      String
  entityType  String
  entityId    String?
  description String
  metadata    Json?
  timestamp   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType])
  @@index([timestamp])
}

// ====== إعدادات المصنع ======
model FactorySettings {
  id                  String   @id @default("singleton")
  factoryName         String
  factoryNameEn       String?
  slogan              String?
  phone               String?
  whatsapp            String?
  email               String?
  address             String?
  taxNumber           String?
  commercialRegister  String?
  logo                String?
  currency            String   @default("ج.م")
  invoicePrefix       String?  @default("INV-")
  invoiceFooter       String?
  defaultPaperSize    String?  @default("A4")
  taxRate             Float?   @default(0)
  updatedAt           DateTime @updatedAt
}

// ====== الموظفون ======
model Worker {
  id              String   @id @default(cuid())
  name            String
  phone           String?
  job             String?
  type            String   @default("monthly")
  hourlyRate      Float?
  overtimeRate    Float?
  workStartTime   String?
  workHoursPerDay Float?
  monthlySalary   Float?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  advances     WorkerAdvance[]
  receipts     WorkerReceipt[]
  attendance   WorkerAttendance[]
  productions  Production[]

  @@index([name])
}

model WorkerAdvance {
  id        String   @id @default(cuid())
  workerId  String
  companyId  String?
  amount    Float
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@index([companyId])
  @@index([date])
}

model WorkerReceipt {
  id        String   @id @default(cuid())
  workerId  String
  companyId  String?
  amount    Float
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@index([companyId])
  @@index([date])
}

model WorkerAttendance {
  id            String   @id @default(cuid())
  workerId      String
  date          DateTime
  checkIn       DateTime?
  checkOut      DateTime?
  status        String   @default("present")
  notes         String?
  workHours     Float?
  overtimeHours Float?
  lateMinutes   Int?
  createdAt     DateTime @default(now())

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@index([date])
}

model Production {
  id         String   @id @default(cuid())
  workerId   String
  date       DateTime
  modelName  String
  quantity   Float
  unitPrice  Float
  total      Float
  notes      String?
  createdAt  DateTime @default(now())

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@index([date])
}

// ====== العملاء والموردون ======
model Customer {
  id             String   @id @default(cuid())
  name           String
  phone          String?
  address        String?
  notes          String?
  creditLimit    Float?
  loyaltyPoints  Int      @default(0)
  openingBalance Float?   @default(0)
  createdAt      DateTime @default(now())

  sales    Sale[]
  payments Payment[] @relation("PaymentCustomer")

  @@index([name])
}

model Supplier {
  id             String   @id @default(cuid())
  name           String
  phone          String?
  address        String?
  notes          String?
  creditLimit    Float?
  openingBalance Float?   @default(0)
  createdAt      DateTime @default(now())

  purchases      Purchase[]
  payments       Payment[] @relation("PaymentSupplier")

  @@index([name])
}

// ====== المبيعات ======
model Sale {
  id             String   @id @default(cuid())
  invoiceNo      String?
  customerName   String
  customerId_ref String?
  date           DateTime
  subtotal       Float    @default(0)
  discountType   String?
  discountValue  Float?   @default(0)
  discountAmount Float?   @default(0)
  taxRate        Float?   @default(0)
  taxAmount      Float?   @default(0)
  extraFees      Float?   @default(0)
  total          Float
  paid           Float
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer Customer? @relation(fields: [customerId_ref], references: [id], onDelete: SetNull)
  items    SaleItem[]
  returns  SaleReturn[]

  @@index([date])
  @@index([customerId_ref])
}

model SaleItem {
  id         String  @id @default(cuid())
  saleId     String
  itemName   String
  productId  String?
  priceType  String?
  quantity   Float
  unitPrice  Float
  total      Float

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

// ====== المشتريات ======
model Purchase {
  id             String   @id @default(cuid())
  invoiceNo      String?
  supplierName   String
  supplierId_ref String?
  date           DateTime
  subtotal       Float    @default(0)
  discountType   String?
  discountValue  Float?   @default(0)
  discountAmount Float?   @default(0)
  taxRate        Float?   @default(0)
  taxAmount      Float?   @default(0)
  extraFees      Float?   @default(0)
  total          Float
  paid           Float
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  supplier Supplier? @relation(fields: [supplierId_ref], references: [id], onDelete: SetNull)
  items    PurchaseItem[]
  returns  PurchaseReturn[]

  @@index([date])
  @@index([supplierId_ref])
}

model PurchaseItem {
  id          String  @id @default(cuid())
  purchaseId  String
  itemName    String
  materialId  String?
  quantity    Float
  unitPrice   Float
  total       Float

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
}

// ====== المصاريف ======
model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String
  notes     String?
  createdAt DateTime @default(now())

  expenses Expense[]
}

model Expense {
  id           String   @id @default(cuid())
  categoryId   String
  categoryName String
  amount       Float
  date         DateTime
  notes        String?
  createdAt    DateTime @default(now())

  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([categoryId])
}

// ====== الخزينة ======
model TreasuryTransaction {
  id            String   @id @default(cuid())
  type          String
  amount        Float
  date          DateTime
  description   String
  category      String?
  referenceType String?
  referenceId   String?
  notes         String?
  createdAt     DateTime @default(now())

  @@index([date])
  @@index([type])
}

// ====== المخازن ======
model Warehouse {
  id        String   @id @default(cuid())
  name      String
  type      String
  location  String?
  notes     String?
  createdAt DateTime @default(now())

  materials Material[]
  products  Product[]
}

model Material {
  id            String   @id @default(cuid())
  name          String
  unit          String
  warehouseId   String
  quantity      Float    @default(0)
  unitCost      Float    @default(0)
  reorderLevel  Float?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  warehouse           Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  materialTransactions MaterialTransaction[]

  @@index([warehouseId])
  @@index([name])
}

model MaterialTransaction {
  id            String   @id @default(cuid())
  materialId    String
  warehouseId   String
  type          String
  quantity      Float
  unitCost      Float?
  date          DateTime
  reason        String
  referenceType String?
  referenceId   String?
  notes         String?
  createdAt     DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@index([date])
  @@index([warehouseId])
}

// ====== المنتجات ======
model Product {
  id                  String   @id @default(cuid())
  name                String
  category            String?
  unit                String
  wholesalePrice      Float    @default(0)
  halfWholesalePrice  Float    @default(0)
  retailPrice         Float    @default(0)
  cost                Float    @default(0)
  warehouseId         String?
  quantity            Float    @default(0)
  reorderLevel        Float?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([warehouseId])
}

// ====== أوامر التشغيل ======
model ProductionOrder {
  id                String   @id @default(cuid())
  orderNumber       String
  productId         String
  productName       String
  quantity          Float
  completedQuantity Float    @default(0)
  unit              String
  status            String   @default("draft")
  materials         Json
  stages            Json
  date              DateTime
  expectedEndDate   DateTime?
  completedDate     DateTime?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([date])
  @@index([status])
  @@index([productId])
}

// ====== السدادات ======
model Payment {
  id         String   @id @default(cuid())
  type       String
  partyId    String
  partyName  String
  invoiceId  String?
  invoiceNo  String?
  amount     Float
  date       DateTime
  method     String?
  notes      String?
  createdAt  DateTime @default(now())

  customer Customer? @relation("PaymentCustomer", fields: [partyId], references: [id], onDelete: SetNull, map: "payment_customer_fk")
  supplier Supplier? @relation("PaymentSupplier", fields: [partyId], references: [id], onDelete: SetNull, map: "payment_supplier_fk")

  @@index([date])
  @@index([partyId])
  @@index([type])
}

// ====== مرتجع المبيعات ======
model SaleReturn {
  id            String   @id @default(cuid())
  returnNumber  String
  saleId        String
  invoiceNo     String?
  customerName  String
  customerId_ref String?
  date          DateTime
  total         Float
  reason        String?
  restockItems  Boolean  @default(true)
  items         Json
  notes         String?
  createdAt     DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([saleId])
}

// ====== مرتجع المشتريات ======
model PurchaseReturn {
  id             String   @id @default(cuid())
  returnNumber   String
  purchaseId     String
  invoiceNo      String?
  supplierName   String
  supplierId_ref String?
  date           DateTime
  total          Float
  reason         String?
  restockItems   Boolean  @default(true)
  items          Json
  notes          String?
  createdAt      DateTime @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([purchaseId])
}
