// Prisma schema for Selim ERP - Neon PostgreSQL
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  user
}

enum WorkerType {
  monthly
  production
  hourly
}

enum AttendanceStatus {
  present
  absent
  leave
}

enum TreasuryTransactionType {
  deposit
  withdrawal
  transfer
}

enum WarehouseType {
  raw_materials
  finished_goods
  general
}

enum MaterialTransactionType {
  in
  out
  transfer
  adjustment
}

enum ProductionOrderStatus {
  draft
  in_progress
  completed
  cancelled
}

enum PaymentType {
  customer_payment
  supplier_payment
}

// ====== الشركات (Multi-Tenancy) ======
model Company {
  id        String   @id @default(cuid())
  name      String
  code      String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  factorySettings      FactorySettings[]
  customers            Customer[]
  suppliers            Supplier[]
  products             Product[]
  materials            Material[]
  warehouses           Warehouse[]
  sales                Sale[]
  purchases            Purchase[]
  expenses             Expense[]
  expenseCategories    ExpenseCategory[]
  treasuryTransactions TreasuryTransaction[]
  workers              Worker[]
  productionOrders     ProductionOrder[]
  payments             Payment[]
  saleReturns          SaleReturn[]
  purchaseReturns      PurchaseReturn[]
  productions          Production[]
  workerAttendances    WorkerAttendance[]
  materialTransactions MaterialTransaction[]
}

// ====== المستخدمون ======
model User {
  id           String   @id @default(cuid())
  companyId    String?
  username     String   @unique
  passwordHash String
  name         String
  role         UserRole @default(admin)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company   Company?   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@index([companyId])
}

// ====== سجل العمليات ======
model AuditLog {
  id          String   @id @default(cuid())
  companyId   String?
  userId      String?
  userName    String
  action      String
  entityType  String
  entityId    String?
  description String
  metadata    Json?
  timestamp   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([entityType])
  @@index([timestamp])
}

// ====== إعدادات المصنع ======
model FactorySettings {
  companyId          String   @id
  factoryName        String
  factoryNameEn      String?
  slogan             String?
  phone              String?
  whatsapp           String?
  email              String?
  address            String?
  taxNumber          String?
  commercialRegister String?
  logo               String?
  currency           String   @default("ج.م")
  invoicePrefix      String?  @default("INV-")
  invoiceFooter      String?
  defaultPaperSize   String?  @default("A4")
  taxRate            Float?   @default(0)
  updatedAt          DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ====== الموظفون ======
model Worker {
  id              String     @id @default(cuid())
  companyId       String?
  name            String
  phone           String?
  job             String?
  type            WorkerType @default(monthly)
  hourlyRate      Float?
  overtimeRate    Float?
  workStartTime   String?
  workHoursPerDay Float?
  monthlySalary   Float?
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  company     Company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  advances    WorkerAdvance[]
  receipts    WorkerReceipt[]
  attendance  WorkerAttendance[]
  productions Production[]

  @@index([companyId])
  @@index([name])
}

model WorkerAdvance {
  id        String   @id @default(cuid())
  workerId  String
  companyId String?
  amount    Float
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@index([companyId])
  @@index([date])
}

model WorkerReceipt {
  id        String   @id @default(cuid())
  workerId  String
  companyId String?
  amount    Float
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@index([companyId])
  @@index([date])
}

model WorkerAttendance {
  id            String           @id @default(cuid())
  companyId     String?
  workerId      String
  date          DateTime
  checkIn       DateTime?
  checkOut      DateTime?
  status        AttendanceStatus @default(present)
  notes         String?
  workHours     Float?
  overtimeHours Float?
  lateMinutes   Int?
  createdAt     DateTime         @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  worker  Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([workerId])
  @@index([date])
}

model Production {
  id             String   @id @default(cuid())
  companyId      String?
  workerId       String
  date           DateTime
  modelName      String
  quantity       Float
  unitPrice      Float
  total          Float
  productId      String?
  addToInventory Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  worker  Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([workerId])
  @@index([date])
  @@index([productId])
}

// ====== العملاء والموردون ======
model Customer {
  id             String   @id @default(cuid())
  companyId      String?
  name           String
  phone          String?
  address        String?
  notes          String?
  creditLimit    Float?
  loyaltyPoints  Int      @default(0)
  openingBalance Float?   @default(0)
  createdAt      DateTime @default(now())

  company  Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sales    Sale[]
  payments Payment[] @relation("PaymentCustomer")

  @@index([companyId])
  @@index([name])
}

model Supplier {
  id             String   @id @default(cuid())
  companyId      String?
  name           String
  phone          String?
  address        String?
  notes          String?
  creditLimit    Float?
  openingBalance Float?   @default(0)
  createdAt      DateTime @default(now())

  company   Company?   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchases Purchase[]
  payments  Payment[]  @relation("PaymentSupplier")

  @@index([companyId])
  @@index([name])
}

// ====== المبيعات ======
model Sale {
  id             String   @id @default(cuid())
  companyId      String?
  invoiceNo      String?
  customerName   String
  customerId_ref String?
  date           DateTime
  subtotal       Float    @default(0)
  discountType   String?
  discountValue  Float?   @default(0)
  discountAmount Float?   @default(0)
  taxRate        Float?   @default(0)
  taxAmount      Float?   @default(0)
  extraFees      Float?   @default(0)
  total          Float
  paid           Float
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company  Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer?    @relation(fields: [customerId_ref], references: [id], onDelete: SetNull)
  items    SaleItem[]
  returns  SaleReturn[]

  @@index([companyId, date]) // composite: تسريع التقارير اليومية/الشهرية
  @@index([companyId, customerId_ref]) // composite: تقارير العملاء
  @@index([companyId])
  @@index([date])
  @@index([invoiceNo])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  itemName  String
  productId String?
  priceType String?
  quantity  Float
  unitPrice Float
  total     Float

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

// ====== المشتريات ======
model Purchase {
  id             String   @id @default(cuid())
  companyId      String?
  invoiceNo      String?
  supplierName   String
  supplierId_ref String?
  date           DateTime
  subtotal       Float    @default(0)
  discountType   String?
  discountValue  Float?   @default(0)
  discountAmount Float?   @default(0)
  taxRate        Float?   @default(0)
  taxAmount      Float?   @default(0)
  extraFees      Float?   @default(0)
  total          Float
  paid           Float
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company  Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier Supplier?        @relation(fields: [supplierId_ref], references: [id], onDelete: SetNull)
  items    PurchaseItem[]
  returns  PurchaseReturn[]

  @@index([companyId, date]) // composite: تسريع التقارير
  @@index([companyId, supplierId_ref]) // composite: تقارير الموردين
  @@index([companyId])
  @@index([date])
  @@index([invoiceNo])
}

model PurchaseItem {
  id         String  @id @default(cuid())
  purchaseId String
  itemName   String
  materialId String?
  quantity   Float
  unitPrice  Float
  total      Float

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
}

// ====== المصاريف ======
model ExpenseCategory {
  id        String   @id @default(cuid())
  companyId String?
  name      String
  notes     String?
  createdAt DateTime @default(now())

  company  Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@index([companyId])
}

model Expense {
  id           String   @id @default(cuid())
  companyId    String?
  categoryId   String
  categoryName String
  amount       Float
  date         DateTime
  notes        String?
  createdAt    DateTime @default(now())

  company  Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([companyId, date]) // composite: تقارير المصاريف
  @@index([companyId])
  @@index([date])
  @@index([categoryId])
}

// ====== الخزينة ======
model TreasuryTransaction {
  id            String                  @id @default(cuid())
  companyId     String?
  type          TreasuryTransactionType
  amount        Float
  date          DateTime
  description   String
  category      String?
  referenceType String?
  referenceId   String?
  notes         String?
  createdAt     DateTime                @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, date]) // composite: تقارير الخزينة
  @@index([companyId, type]) // composite: تصفية بالنوع
  @@index([companyId])
  @@index([date])
  @@index([type])
}

// ====== المخازن ======
model Warehouse {
  id        String        @id @default(cuid())
  companyId String?
  name      String
  type      WarehouseType
  location  String?
  notes     String?
  createdAt DateTime      @default(now())

  company   Company?   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  materials Material[]
  products  Product[]

  @@index([companyId])
}

model Material {
  id           String   @id @default(cuid())
  companyId    String?
  name         String
  unit         String
  warehouseId  String
  quantity     Float    @default(0)
  unitCost     Float    @default(0)
  reorderLevel Float?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company              Company?              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse            Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  materialTransactions MaterialTransaction[]

  @@index([companyId])
  @@index([warehouseId])
  @@index([name])
}

model MaterialTransaction {
  id            String                  @id @default(cuid())
  companyId     String?
  materialId    String
  warehouseId   String
  type          MaterialTransactionType
  quantity      Float
  unitCost      Float?
  date          DateTime
  reason        String
  referenceType String?
  referenceId   String?
  notes         String?
  createdAt     DateTime                @default(now())

  company  Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([materialId])
  @@index([date])
  @@index([warehouseId])
}

// ====== المنتجات ======
model Product {
  id                 String   @id @default(cuid())
  companyId          String?
  name               String
  category           String?
  unit               String
  wholesalePrice     Float    @default(0)
  halfWholesalePrice Float    @default(0)
  retailPrice        Float    @default(0)
  cost               Float    @default(0)
  warehouseId        String?
  quantity           Float    @default(0)
  reorderLevel       Float?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company     Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse   Warehouse?   @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  productions Production[]

  @@index([companyId])
  @@index([name])
  @@index([warehouseId])
}

// ====== أوامر التشغيل ======
model ProductionOrder {
  id                String                @id @default(cuid())
  companyId         String?
  orderNumber       String
  productId         String
  productName       String
  quantity          Float
  completedQuantity Float                 @default(0)
  unit              String
  status            ProductionOrderStatus @default(draft)
  materials         Json
  stages            Json
  date              DateTime
  expectedEndDate   DateTime?
  completedDate     DateTime?
  notes             String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([orderNumber])
  @@index([companyId])
  @@index([date])
  @@index([status])
  @@index([productId])
}

// ====== السدادات ======
model Payment {
  id          String      @id @default(cuid())
  companyId   String?
  type        PaymentType
  partyId     String
  partyName   String
  customerId  String?
  supplierId  String?
  invoiceId   String?
  invoiceNo   String?
  amount      Float
  date        DateTime
  method      String?
  notes       String?
  createdAt   DateTime    @default(now())

  company  Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer? @relation("PaymentCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  supplier Supplier? @relation("PaymentSupplier", fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([date])
  @@index([partyId])
  @@index([customerId])
  @@index([supplierId])
  @@index([type])
}

// ====== مرتجع المبيعات ======
model SaleReturn {
  id             String   @id @default(cuid())
  companyId      String?
  returnNumber   String
  saleId         String
  invoiceNo      String?
  customerName   String
  customerId_ref String?
  date           DateTime
  total          Float
  reason         String?
  restockItems   Boolean  @default(true)
  items          Json
  notes          String?
  createdAt      DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([companyId, date]) // composite: تقارير المرتجعات
  @@index([companyId])
  @@index([date])
  @@index([saleId])
}

// ====== مرتجع المشتريات ======
model PurchaseReturn {
  id             String   @id @default(cuid())
  companyId      String?
  returnNumber   String
  purchaseId     String
  invoiceNo      String?
  supplierName   String
  supplierId_ref String?
  date           DateTime
  total          Float
  reason         String?
  restockItems   Boolean  @default(true)
  items          Json
  notes          String?
  createdAt      DateTime @default(now())

  company  Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([companyId, date]) // composite: تقارير مرتجعات المشتريات
  @@index([companyId])
  @@index([date])
  @@index([purchaseId])
}
